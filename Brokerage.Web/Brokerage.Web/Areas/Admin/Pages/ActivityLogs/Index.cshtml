@page
@model Brokerage.Web.Areas.Admin.Pages.ActivityLogs.IndexModel

@{
    ViewData["Title"] = "Activity Logs";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/activity-logs.css"
          asp-append-version="true" />
}

@{
    string FormatAction(string action)
    {
        if (string.IsNullOrWhiteSpace(action))
        {
            return "UNKNOWN";
        }

        return action
            .Replace("_", " ")
            .ToUpper();
    }

    string GetActionClass(string action)
    {
        return action switch
        {
            "PROPERTY_APPROVED" => "badge-approved",
            "PROPERTY_REJECTED" => "badge-suspended",
            "PROPERTY_UPDATED" => "badge-updated",
            "PROPERTY_CREATED" => "badge-permission",
            "PROPERTY_SUBMITTED" => "badge-permission",
            "PROPERTY_AMENITIES_UPDATED" => "badge-permission",
            "PROPERTY_MEDIA_UPDATED" => "badge-permission",
            "USER_REGISTERED" => "badge-permission",
            "USER_LOGIN_SUCCESS" => "badge-approved",
            "USER_LOGIN_FAILED" => "badge-failed",
            "USER_LOGIN_BLOCKED" => "badge-failed",
            "PASSWORD_RESET_REQUESTED" => "badge-permission",
            "PASSWORD_RESET_COMPLETED" => "badge-approved",
            "USER_REGISTRATION_FAILED" => "badge-failed",
            _ => "badge-permission"
        };
    }
}

<div class="activity-logs-container">

    <form method="get"
          asp-page="./Index"
          id="activityLogFilterForm">

        <div class="activity-filters">

            <div class="filter-card">
                <div class="filter-label">
                    DATE RANGE
                </div>

                <div class="filter-title">
                    Custom Filter
                </div>

                <div class="date-range-wrapper">

                    <div class="date-input-wrapper">
                        <i class="fa-regular fa-calendar"></i>

                        <input asp-for="FromDate"
                               type="date"
                               class="activity-date-input" />
                    </div>

                    <span class="date-arrow">→</span>

                    <div class="date-input-wrapper">
                        <i class="fa-regular fa-calendar"></i>

                        <input asp-for="ToDate"
                               type="date"
                               class="activity-date-input" />
                    </div>

                </div>
            </div>


            <div class="filter-card">
                <div class="filter-label">
                    ACTOR
                </div>

                <div class="filter-title">
                    Search Actor
                </div>

                <div class="actor-search-wrapper">

                    <input asp-for="ActorSearch"
                           type="text"
                           class="actor-search-input"
                           placeholder="Search by actor name..."
                           autocomplete="off" />

                    <i class="fa-solid fa-magnifying-glass actor-search-icon"></i>

                </div>
            </div>


            <div class="filter-card">
                <div class="filter-label">
                    ACTION CATEGORY
                </div>

                <div class="filter-title">
                    Activity Type
                </div>

                <div class="action-category-buttons">

                    <button type="submit"
                            name="ActionCategory"
                            value=""
                            class="filter-action-btn @(string.IsNullOrWhiteSpace(Model.ActionCategory) ? "active" : "")">
                        ALL ACTIONS
                    </button>

                    <button type="submit"
                            name="ActionCategory"
                            value="AUTHENTICATION"
                            class="filter-action-btn @(Model.ActionCategory == "AUTHENTICATION" ? "active" : "")">
                        AUTHENTICATION
                    </button>

                    <button type="submit"
                            name="ActionCategory"
                            value="USER"
                            class="filter-action-btn @(Model.ActionCategory == "USER" ? "active" : "")">
                        USER
                    </button>

                    <button type="submit"
                            name="ActionCategory"
                            value="PROPERTY"
                            class="filter-action-btn @(Model.ActionCategory == "PROPERTY" ? "active" : "")">
                        PROPERTY
                    </button>

                    <button type="submit"
                            name="ActionCategory"
                            value="ADMIN"
                            class="filter-action-btn @(Model.ActionCategory == "ADMIN" ? "active" : "")">
                        ADMIN
                    </button>

                </div>
            </div>

        </div>


        <div class="activity-filter-actions">

            <button type="submit"
                    class="btn-apply-filters">
                Apply Filters
            </button>

            <a asp-page="./Index"
               class="btn-reset-filters">
                Reset All
            </a>

        </div>

    </form>


    <!-- Activity Table -->

    <div class="audit-card">

        <!-- Activity Header -->

        <div class="audit-header">

            <div class="live-indicator">

                <span class="live-dot"></span>

                <h2 class="audit-title">
                    Activity Stream
                </h2>

            </div>


            <div class="audit-meta">

                <span class="events-count">

                    Showing
                    @Model.Logs.Count
                    of
                    @Model.TotalRecords
                    Events

                </span>


                <div class="header-nav-btns">

                    @if (Model.HasPreviousPage)
                    {
                        <a asp-page="./Index"
                           asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           asp-route-ActorSearch="@Model.ActorSearch"
                           asp-route-ActionCategory="@Model.ActionCategory"
                           asp-route-PageNumber="@(Model.PageNumber - 1)"
                           class="btn-nav"
                           aria-label="Previous">

                            &lt;

                        </a>
                    }
                    else
                    {
                        <span class="btn-nav disabled">
                            &lt;
                        </span>
                    }


                    @if (Model.HasNextPage)
                    {
                        <a asp-page="./Index"
                           asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           asp-route-ActorSearch="@Model.ActorSearch"
                           asp-route-ActionCategory="@Model.ActionCategory"
                           asp-route-PageNumber="@(Model.PageNumber + 1)"
                           class="p-btn">

                            &gt;

                        </a>
                    }
                    else
                    {
                        <span class="btn-nav disabled">
                            &gt;
                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- Activity Table -->

        <div class="table-responsive">

            <table class="audit-table">

                <thead>

                    <tr>

                        <th>
                            TIMESTAMP
                        </th>

                        <th>
                            ACTOR
                        </th>

                        <th>
                            ACTION
                        </th>

                        <th>
                            AFFECTED OBJECT
                        </th>

                        <th>
                            RESULT
                        </th>

                        <th class="text-right">
                            DETAILS
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Logs.Count == 0)
                    {
                        <tr>

                            <td colspan="6"
                                class="empty-log-message">

                                No activity logs found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model.Logs)
                        {
                            DateTime localTime = log.CreatedAt.ToLocalTime();
                            string formattedTimestamp =
                                localTime.ToString("dd-MM-yyyy hh:mm:ss tt");
                            string initials = "SYS";

                            if (!string.IsNullOrWhiteSpace(log.ActorName))
                            {
                                string[] nameParts =
                                    log.ActorName
                                        .Split(
                                            ' ',
                                            StringSplitOptions.RemoveEmptyEntries);

                                initials =
                                    string.Concat(
                                        nameParts
                                            .Take(2)
                                            .Select(x => x[0]))
                                    .ToUpper();
                            }

                            string actionClass =
                                GetActionClass(log.ActionType);

                            bool isSuccess =
                                log.Result.Equals(
                                    "Success",
                                    StringComparison.OrdinalIgnoreCase);

                            string resultClass =
                                isSuccess
                                    ? "success"
                                    : "warning";

                            <tr>

                                <!-- Timestamp -->

                                <td>
                                    <div class="timestamp">
                                        <div class="timestamp-date">@formattedTimestamp</div>
                                    </div>
                                </td>


                                <!-- Actor -->

                                <td>

                                    <div class="admin-cell">

                                        <div class="avatar-circle
                                            @(log.ActorName == "System"
                                                ? "avatar-sys"
                                                : "")">

                                            @initials

                                        </div>


                                        <div>

                                            <span class="admin-name">

                                                @(string.IsNullOrWhiteSpace(log.ActorName)
                                                    ? "System"
                                                    : log.ActorName)

                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(
                                                log.ActorRole))
                                            {
                                                <span class="actor-role">

                                                    @log.ActorRole

                                                </span>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- Action -->

                                <td>

                                    <span class="action-badge @actionClass">

                                        @FormatAction(log.ActionType)

                                    </span>

                                </td>


                                <!-- Affected Object -->

                                <td>

                                    <div class="object-cell">

                                        <span class="object-name">

                                            @(log.EntityName ?? "N/A")

                                        </span>

                                        @if (log.EntityID.HasValue)
                                        {
                                            <span class="object-id">

                                                @log.EntityType ID:
                                                @log.EntityID

                                            </span>
                                        }

                                    </div>

                                </td>


                                <!-- Result -->

                                <td>

                                    <div class="result-icon @resultClass"
                                         title="@log.Result">

                                        @if (isSuccess)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                 fill="none"
                                                 viewBox="0 0 24 24"
                                                 stroke="currentColor">

                                                <path stroke-linecap="round"
                                                      stroke-linejoin="round"
                                                      stroke-width="2"
                                                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />

                                            </svg>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                 fill="none"
                                                 viewBox="0 0 24 24"
                                                 stroke="currentColor">

                                                <path stroke-linecap="round"
                                                      stroke-linejoin="round"
                                                      stroke-width="2"
                                                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />

                                            </svg>
                                        }

                                    </div>

                                </td>


                                <!-- Details -->

                                <td class="text-right">

                                    <button type="button"
                                            class="btn-details"
                                            data-details="@log.Details"
                                            data-action="@FormatAction(log.ActionType)"
                                            data-actor="@log.ActorName"
                                            data-object="@($"{log.EntityName} ({log.EntityType}, ID: {log.EntityID})")"
                                            data-result="@log.Result"
                                            data-timestamp="@formattedTimestamp"
                                            aria-label="View activity details"
                                            title="View details">

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="18"
                                             height="18"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             aria-hidden="true">

                                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />

                                            <circle cx="12" cy="12" r="2.5" />

                                        </svg>

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>


        <!-- Pagination -->

        <div class="audit-footer">

            <div>

                <span class="events-count">

                    Showing
                    @Model.Logs.Count
                    of
                    @Model.TotalRecords
                    Events

                </span>

            </div>


            <div class="pagination-wrapper">

                @if (Model.TotalPages > 0)
                {
                    <span class="page-indicator">

                        Page
                        @Model.PageNumber
                        of
                        @Model.TotalPages

                    </span>


                    <div class="pagination-controls">

                        @if (Model.HasPreviousPage)
                        {
                            <a asp-page="./Index"
                               asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                               asp-route-ActorSearch="@Model.ActorSearch"
                               asp-route-ActionCategory="@Model.ActionCategory"
                               asp-route-PageNumber="@(Model.PageNumber - 1)"
                               class="btn-nav"
                               aria-label="Previous">

                                &lt;

                            </a>
                        }


                        @foreach (int? pageItem in Model.GetPaginationSequence())
                        {
                            if (pageItem.HasValue)
                            {
                                <a asp-page="./Index"
                                   asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                   asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                                   asp-route-ActorSearch="@Model.ActorSearch"
                                   asp-route-ActionCategory="@Model.ActionCategory"
                                   asp-route-PageNumber="@pageItem.Value"
                                   class="p-btn @(pageItem.Value == Model.PageNumber ? "active" : "")">

                                    @pageItem.Value

                                </a>
                            }
                            else
                            {
                                <span class="p-btn disabled">...</span>
                            }
                        }


                        @if (Model.HasNextPage)
                        {
                            <a asp-page="./Index"
                               asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                               asp-route-ActorSearch="@Model.ActorSearch"
                               asp-route-ActionCategory="@Model.ActionCategory"
                               asp-route-PageNumber="@(Model.PageNumber + 1)"
                               class="p-btn">

                                &gt;

                            </a>
                        }

                    </div>
                }
                else
                {
                    <span class="page-indicator">
                        No pages
                    </span>
                }

            </div>

        </div>

    </div>

</div>


<!-- Details Modal -->

<div id="activityDetailsModal"
     class="activity-details-modal"
     aria-hidden="true">

    <div class="activity-details-overlay"></div>

    <div class="activity-details-dialog">

        <div class="activity-details-header">

            <div>

                <span class="card-label">
                    ACTIVITY DETAILS
                </span>

                <h3 id="detailsAction">
                    Activity
                </h3>

            </div>

            <button type="button"
                    class="details-modal-close"
                    aria-label="Close">

                &times;

            </button>

        </div>


        <div class="activity-details-body">

            <div class="details-item">

                <span class="details-label">
                    Timestamp
                </span>

                <span id="detailsTimestamp"
                      class="details-value">
                </span>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Actor
                </span>

                <span id="detailsActor"
                      class="details-value">
                </span>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Affected Object
                </span>

                <span id="detailsObject"
                      class="details-value">
                </span>

            </div>


            <div class="details-item">

                <span class="details-label">
                    Result
                </span>

                <span id="detailsResult"
                      class="details-value">
                </span>

            </div>


            <div class="details-description">

                <span class="details-label">
                    Details
                </span>

                <div id="detailsDescription"
                     class="details-description-content">
                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script src="~/js/Admin/activity-logs.js"
            asp-append-version="true">
    </script>
}
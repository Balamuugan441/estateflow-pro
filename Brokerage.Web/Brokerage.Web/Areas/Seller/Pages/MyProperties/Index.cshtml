@page
@model Brokerage.Web.Areas.Seller.Pages.MyProperties.IndexModel

@{
    Layout = "/Areas/Seller/Pages/Shared/_SellerLayout.cshtml";
    ViewData["Title"] = "My Properties";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/seller/my-properties.css"
          asp-append-version="true" />
}

<div class="my-properties-page">
    <div class="my-properties-container">

        <!-- PAGE TITLE & TOOLBAR HEADER -->
<div class="my-properties-header">
    <h1 class="page-title">My Properties</h1>

    <div class="property-toolbar">
        <div class="sort-wrapper">
            <select id="propertySort"
                    class="sort-select"
                    aria-label="Sort properties">
                <option value="latest">Sort by: Latest</option>
                <option value="oldest">Sort by: Oldest</option>
                <option value="price-high">Price: High to Low</option>
                <option value="price-low">Price: Low to High</option>
            </select>
        </div>

        <a asp-area="Seller"
           asp-page="/AddProperty/Index"
           class="add-property-button">
            <svg class="add-property-icon-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            <span>Add Property</span>
        </a>
    </div>
</div>

        <!-- ERROR MESSAGE -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="properties-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(x => x.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <!-- EMPTY STATE -->
        @if (Model.Properties.Count == 0)
        {
            <div class="properties-empty-state">
                <div class="empty-state-icon">
                    <img src="~/images/icons/property/empty-property.png" alt="" />
                </div>
                <h2>No properties listed yet</h2>
                <p>Start managing your listings by adding your first property.</p>
                <a asp-area="Seller"
                   asp-page="/AddProperty/Index"
                   class="empty-state-button">
                   <span class="add-property-icon">
                       <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                           <line x1="12" y1="5" x2="12" y2="19"></line>
                           <line x1="5" y1="12" x2="19" y2="12"></line>
                       </svg>
                   </span>
                   <span>Add Property</span>
                </a>
            </div>
        }

        <!-- PROPERTY GRID -->
        <div id="propertiesGrid" class="properties-grid">
            @foreach (var item in Model.Properties)
            {
                var property = item.Property;

                <article class="property-card"
                         data-created-at="@property.CreatedAt.Ticks"
                         data-price="@property.Price">

                    <!-- PROPERTY IMAGE & BADGES -->
                    <div class="property-image-container">
                        @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                        {
                            <img src="@item.CoverImageUrl"
                                 class="property-image"
                                 alt="@property.PropertyTitle"
                                 data-property-image
                                 data-placeholder="@Url.Content("~/images/property-placeholder.png")" />
                        }
                        else
                        {
                            <img src="~/images/property-placeholder.png"
                                 class="property-image"
                                 alt="Property image"
                                 data-property-image />
                        }

                        <div class="property-badges">
                            <span class="property-badge listing-type-badge">
                                @property.ListingType
                            </span>

                            @if (string.Equals(property.PropertyStatus, "Ready to Move", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="property-badge premium-badge">
                                    PREMIUM
                                </span>
                            }
                        </div>
                    </div>

                    <!-- PROPERTY CARD BODY -->
                    <div class="property-card-body">
                        
                        <!-- TITLE & PRICE -->
                        <div class="property-title-price-row">
                            <div class="property-title-wrapper">
                                <h2 class="property-title" title="@property.PropertyTitle">
                                    @property.PropertyTitle
                                </h2>
                                @if (!string.IsNullOrWhiteSpace(property.PropertyType))
                                {
                                    <span class="property-type">
                                        @property.PropertyType
                                    </span>
                                }
                            </div>

                            <div class="property-price-wrapper">
                                <span class="property-price">
                                    ₹@property.Price.ToString("N0")
                                </span>
                                @if (string.Equals(property.ListingType, "For Rent", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="property-price-period">/month</span>
                                }
                            </div>
                        </div>

                        <!-- LOCATION -->
                        <div class="property-location">
                            <img src="~/images/icons/property/location.png"
                                 class="property-small-icon"
                                 alt="" />
                            <span class="location-text">
                                @property.City@(!string.IsNullOrWhiteSpace(property.State) ? $", {property.State}" : "")
                            </span>
                        </div>

                        <div class="property-card-divider"></div>

                        <!-- SPECIFICATIONS (PILL GRID) -->
                        <div class="property-specifications">
                            <div class="property-specification">
                                <img src="~/images/icons/property/bed.png"
                                     class="property-specification-icon"
                                     alt="" />
                                <span class="property-specification-value">
                                    <strong>@property.Bedrooms</strong>
                                    <small>Beds</small>
                                </span>
                            </div>

                            <div class="property-specification">
                                <img src="~/images/icons/property/bath.png"
                                     class="property-specification-icon"
                                     alt="" />
                                <span class="property-specification-value">
                                    <strong>@property.Bathrooms</strong>
                                    <small>Baths</small>
                                </span>
                            </div>

                            <div class="property-specification">
                                <img src="~/images/icons/property/area.png"
                                     class="property-specification-icon"
                                     alt="" />
                                <span class="property-specification-value">
                                    <strong>@property.Area.ToString("N0")</strong>
                                    <small>@property.AreaUnit</small>
                                </span>
                            </div>
                        </div>

                    </div>
                </article>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/seller/my-properties.js"
            asp-append-version="true">
    </script>
}
<footer class="seller-footer">

    <div class="footer-container">

        <!--TOP FOOTER CONTENT-->

        <div class="footer-content">

            <div class="footer-brand-section">

                <a asp-area="Seller"
                   asp-page="/MyProperties/Index"
                   class="footer-brand">

                    <img src="~/images/branding/estateflow-pro-logo.png"
                         alt="EstateFlow Pro"
                         class="footer-logo" />

                    <span class="footer-brand-name">
                        EstateFlow <span>Pro</span>
                    </span>

                </a>


                <p class="footer-description">
                    Setting the standard for international real estate
                    brokerage and asset management since 2012.
                </p>


                <!-- Social / Utility Icons -->

                <div class="footer-social">

                    <button type="button"
                            class="footer-social-button"
                            aria-label="Share">

                        <img src="~/images/icons/Share.png"
                             alt=""
                             class="footer-social-icon" />

                    </button>


                    <button type="button"
                            class="footer-social-button"
                            aria-label="Website">

                        <img src="~/images/icons/globe.png"
                             alt=""
                             class="footer-social-icon" />

                    </button>

                </div>

            </div>


            <!--PLATFORM -->

            <div class="footer-column">

                <h3 class="footer-title">
                    PLATFORM
                </h3>

                <ul class="footer-links">

                    <li>
                        <a asp-page="/Buy">
                            Buy Property
                        </a>
                    </li>

                    <li>
                        <a asp-page="/Rent">
                            Rent Listings
                        </a>
                    </li>

                    <li>
                        <a asp-area="Seller"
                           asp-page="/MyProperties/Index">
                            Sell Your Asset
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Commercial Portal
                        </a>
                    </li>

                </ul>

            </div>


            <!-- =====================================
                 SUPPORT
                 ===================================== -->

            <div class="footer-column">

                <h3 class="footer-title">
                    SUPPORT
                </h3>

                <ul class="footer-links">

                    <li>
                        <a href="#">
                            Help Center
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Privacy Policy
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Broker Portal
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Affiliate Program
                        </a>
                    </li>

                </ul>

            </div>


            <!-- SUBSCRIBE -->

            <div class="footer-column footer-subscribe">

                <h3 class="footer-title">
                    SUBSCRIBE
                </h3>


                <p class="footer-subscribe-description">
                    Join our newsletter for exclusive off-market
                    listings and market insights.
                </p>


                <form class="footer-subscribe-form"
                      method="post">

                    <input type="email"
                           name="email"
                           placeholder="Email Address"
                           aria-label="Email Address"
                           autocomplete="email" />


                    <button type="submit"
                            class="footer-subscribe-button"
                            aria-label="Subscribe">



                        <img src="~/images/icons/send-icon.png"
                             alt=""
                             class="footer-send-icon" />

                    </button>

                </form>

            </div>

        </div>


     

        <div class="footer-divider"></div>


        <!--FOOTER BOTTOM-->

        <div class="footer-bottom">


            <!-- Copyright -->

            <div class="footer-copyright">

                © 2026 EstateFlow Pro. All rights reserved.

            </div>


            <!-- Legal Links -->

            <div class="footer-legal">

                <a href="#">
                    Terms of Service
                </a>

                <a href="#">
                    Cookie Policy
                </a>

            </div>

        </div>

    </div>

</footer>
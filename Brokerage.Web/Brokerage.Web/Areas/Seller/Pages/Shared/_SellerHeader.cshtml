<header class="main-header">

    <div class="header-container">

        <!-- LEFT: BRAND + NAVIGATION -->

        <div class="header-left">

            <a asp-area="Seller"
               asp-page="/MyProperties/Index"
               class="header-brand"
               aria-label="EstateFlow Pro">


                <img src="~/images/branding/estateflow-pro-logo.png"
                     alt="EstateFlow Pro"
                     class="brand-logo-icon" />


                <span class="brand-text">
                    EstateFlow <span>Pro</span>
                </span>

            </a>

        </div>


        <!-- RIGHT: ACTIONS + PROFILE -->

        <div class="header-right">

            <div class="header-actions">

    <!-- BUY REQUESTS -->

    <a asp-area="Seller"
       asp-page="/BuyRequests/Index"
       class="action-btn"
       aria-label="Buy Requests">

       <img width="32" height="24" src="https://img.icons8.com/fluency-systems-regular/48/FFFFFF/list--v1.png" alt="list--v1" />

    </a>


    <!-- NOTIFICATIONS -->

   <button type="button"
        class="action-btn notification-center-button"
        aria-label="Notifications"

        data-unread-url="@Url.Page(
            "/Notifications/Index",
            new
            {
                area = "Seller",
                handler = "Unread"
            })"

        data-read-url="@Url.Page(
            "/Notifications/Index",
            new
            {
                area = "Seller",
                handler = "Read"
            })"

        data-notifications-url="@Url.Page(
            "/Notifications/Index",
            new
            {
                area = "Seller"
            })"

        data-notification-scope="seller-@User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier
        )?.Value">

    <svg class="header-action-svg"
         viewBox="0 0 24 24"
         fill="none"
         stroke="#ffffff"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">

        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />

        <path d="M13.73 21a2 2 0 0 1-3.46 0" />

    </svg>

    <span class="notification-center-badge"
          hidden>
        0
    </span>

</button>


    <!-- MESSAGES -->

   <a asp-area="Seller"
   asp-page="/Messages/Index"
   class="action-btn message-header-link"
   aria-label="Messages"
   data-unread-messages-url="@Url.Page(
       "/MyProperties/Index",
       new
       {
           area = "Seller",
           handler = "UnreadMessages"
       })"
   data-message-indicator-scope="seller-@User.FindFirst(
       System.Security.Claims.ClaimTypes.NameIdentifier
   )?.Value">

   <img width="32" height="24" src="https://img.icons8.com/fluency-systems-regular/48/FFFFFF/chat-message.png" alt="chat-message" />

   <span class="message-unread-indicator"
         aria-label="Unread messages"
         hidden></span>
</a>

</div>

            <!-- Vertical divider -->

            <div class="header-divider"></div>


            <!-- USER PROFILE -->

            <!-- USER PROFILE WRAPPER -->
<div class="user-profile-wrapper">
    <div class="user-profile" id="userProfileToggle" role="button" tabindex="0" aria-expanded="false" aria-haspopup="true">
        <div class="user-info">
            <span class="user-name">
                @User.Identity?.Name
            </span>
            <span class="user-role">
                PROPERTY OWNER
            </span>
        </div>

        <div class="user-avatar-wrapper">
            <img src="~/images/avatars/default-avatar.jpg"
                 alt="Profile"
                 class="user-avatar" />
        </div>

        <!-- Chevron Icon -->
        <svg class="profile-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
    </div>

    <!-- PROFILE DROPDOWN MENU -->
    <div class="profile-dropdown-menu" id="profileDropdown" hidden>
        <div class="dropdown-user-header">
            <span class="dropdown-user-name">@User.Identity?.Name</span>
            <span class="dropdown-user-role">Property Owner</span>
        </div>
        <div class="dropdown-divider"></div>
        <button type="button" class="dropdown-logout-btn" id="logoutBtn">
            <svg class="logout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Log Out</span>
        </button>
    </div>
</div>

        </div>

    </div>
    <div id="notificationPopup"
     class="notification-popup"
     hidden>

    <div class="notification-popup-backdrop"
         data-notification-close>
    </div>


    <div class="notification-popup-content"
         role="dialog"
         aria-modal="true"
         aria-labelledby="notificationPopupTitle">

        <button type="button"
                id="notificationPopupClose"
                class="notification-popup-close"
                aria-label="Close">
            ×
        </button>


        <div class="notification-popup-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />

                <path d="M13.73 21a2 2 0 0 1-3.46 0" />

            </svg>

        </div>


        <span class="notification-popup-label">
            NEW NOTIFICATIONS
        </span>


        <h3 id="notificationPopupTitle">
            You Have New Notifications
        </h3>


        <p id="notificationPopupMessage">
            You have new notifications.
            Tap to view them or dismiss.
        </p>


        <span id="notificationPopupCount"
              class="notification-popup-count">
        </span>


        <div class="notification-popup-actions">

            <button type="button"
                    id="notificationPopupView"
                    class="notification-popup-view">
                View Notifications
            </button>

            <button type="button"
                    id="notificationPopupDismiss"
                    class="notification-popup-dismiss">
                Dismiss
            </button>

        </div>

    </div>

</div>

</header>
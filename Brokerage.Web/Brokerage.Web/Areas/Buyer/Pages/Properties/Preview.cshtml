                             xmlns="http://www.w3.org/2000/svg"
                             width="18"
                             height="18"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span>Chat</span>
                    </button>
                </form>

             <button type="button"
        class="buyer-preview-action buyer-preview-action-save @(Model.IsFavorite ? "is-favorite" : "")"
        data-action="save"
        data-property-guid="@Model.Property.PropertyGUID"
        aria-pressed="@Model.IsFavorite">

    <svg viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2">

        <path d="M20.8 8.7c0 5.3-8.8 10.3-8.8 10.3
                 S3.2 14 3.2 8.7A4.7 4.7 0 0 1
                 12 6.2a4.7 4.7 0 0 1 8.8 2.5Z" />

    </svg>

    <span>Save</span>

</button>

            </div>


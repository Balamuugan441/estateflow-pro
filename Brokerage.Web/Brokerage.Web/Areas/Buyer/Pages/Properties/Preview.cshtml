@section Scripts
{
    <script>
        const galleryItems =
            Array.from(
                document.querySelectorAll(
                    ".gallery-trigger"
                )
            );

        const galleryData =
            @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            Model.GalleryImages.Select(
                                    (PropertyMediaApiModel image) =>
                                            Model.BuildMediaUrl(
                                                    image.FilePath)
                            )
                    )
            );

        const galleryModal =
            document.getElementById(
                "galleryModal"
            );

        const galleryMainImage =
            document.getElementById(
                "galleryMainImage"
            );

        const galleryThumbnails =
            document.getElementById(
                "galleryModalThumbnails"
            );

        const galleryClose =
            document.getElementById(
                "galleryClose"
            );

        const galleryBackdrop =
            document.getElementById(
                "galleryBackdrop"
            );

        const galleryPrevious =
            document.getElementById(
                "galleryPrevious"
            );

        const galleryNext =
            document.getElementById(
                "galleryNext"
            );

        let currentGalleryIndex = 0;

        function renderGalleryModal()
        {
            galleryMainImage.src =
                galleryData[currentGalleryIndex];

            galleryThumbnails.innerHTML =
                "";

            galleryData.forEach(
                function (imageUrl, index)
                {
                    const button =
                        document.createElement(
                            "button"
                        );

                    button.type =
                        "button";

                    button.className =
                        "preview-gallery-modal-thumb";

                    if (
                        index ===
                        currentGalleryIndex
                    )
                    {
                        button.classList.add(
                            "active"
                        );
                    }

                    const image =
                        document.createElement(
                            "img"
                        );

                    image.src =
                        imageUrl;

                    image.alt =
                        `Gallery image ${index + 1}`;

                    button.appendChild(
                        image
                    );

                    button.addEventListener(
                        "click",
                        function ()
                        {
                            currentGalleryIndex =
                                index;

                            renderGalleryModal();
                        }
                    );

                    galleryThumbnails.appendChild(
                        button
                    );
                }
            );
        }

        function openGallery(index)
        {
            if (
                galleryData.length === 0
            )
            {
                return;
            }

            currentGalleryIndex =
                Number(index);

            renderGalleryModal();

            galleryModal.hidden =
                false;

            document.body.classList.add(
                "preview-modal-open"
            );
        }

        function closeGallery()
        {
            galleryModal.hidden =
                true;

            document.body.classList.remove(
                "preview-modal-open"
            );
        }

        galleryItems.forEach(
            function (item)
            {
                item.addEventListener(
                    "click",
                    function ()
                    {
                        openGallery(
                            item.dataset.galleryIndex
                        );
                    }
                );
            }
        );

        galleryPrevious.addEventListener(
            "click",
            function ()
            {
                currentGalleryIndex =
                    currentGalleryIndex === 0
                        ? galleryData.length - 1
                        : currentGalleryIndex - 1;

                renderGalleryModal();
            }
        );

        galleryNext.addEventListener(
            "click",
            function ()
            {
                currentGalleryIndex =
                    currentGalleryIndex ===
                        galleryData.length - 1
                        ? 0
                        : currentGalleryIndex + 1;

                renderGalleryModal();
            }
        );

        galleryClose.addEventListener(
            "click",
            closeGallery
        );

        galleryBackdrop.addEventListener(
            "click",
            closeGallery
        );

        document.addEventListener(
            "keydown",
            function (event)
            {
                if (galleryModal.hidden)
                {
                    return;
                }

                if (event.key === "Escape")
                {
                    closeGallery();
                }

                if (event.key === "ArrowLeft")
                {
                    galleryPrevious.click();
                }

                if (event.key === "ArrowRight")
                {
                    galleryNext.click();
                }
            }
        );


     const saveButton =
    document.querySelector(
        ".buyer-preview-action-save"
    );


function getPreviewRequestVerificationToken() {

    const token =
        document.querySelector(
            'input[name="__RequestVerificationToken"]'
        );

    return token?.value || "";
}


async function togglePreviewFavorite() {

    if (!saveButton) {
        return;
    }

    const propertyGuid =
        saveButton.dataset.propertyGuid;

    if (!propertyGuid) {
        return;
    }

    const currentlyFavorite =
        saveButton.classList.contains(
            "is-favorite"
        );

    const nextFavorite =
        !currentlyFavorite;

    saveButton.disabled = true;

    const body =
        new URLSearchParams();

    body.set(
        "propertyGuid",
        propertyGuid
    );

    body.set(
        "favorite",
        nextFavorite
    );

    try {

        const response =
            await fetch(
                "?handler=Favorite",
                {
                    method: "POST",

                    headers: {
                        "Accept": "application/json",

                        "Content-Type":
                            "application/x-www-form-urlencoded; charset=UTF-8",

                        "RequestVerificationToken":
                            getPreviewRequestVerificationToken()
                    },

                    body:
                        body.toString()
                }
            );

        const result =
            await response.json();

        if (
            !response.ok ||
            !result.success
        ) {

            throw new Error(
                result.message ||
                "Unable to update favorite."
            );
        }

        saveButton.classList.toggle(
            "is-favorite",
            result.isFavorite
        );

        saveButton.setAttribute(
            "aria-pressed",
            result.isFavorite
        );
        window.showFavoriteToast(
    "Success",
    result.isFavorite
        ? "Property added successfully to favorites."
        : "Property removed successfully from favorites."
);

    }
    catch (error) {

        console.error(
            "Preview favorite error:",
            error
        );
        window.showFavoriteToast(
        "Error",
        error.message || "Unable to update favorites.",
        true
    );

    }
    finally {

        saveButton.disabled = false;

    }
}

saveButton?.addEventListener(
    "click",
    togglePreviewFavorite
);
        const buyNowButton =
            document.getElementById(
                "buyNowButton"
            );

        const buyRequestModal =
            document.getElementById(
                "buyRequestModal"
            );

        const buyRequestModalClose =
            document.getElementById(
                "buyRequestModalClose"
            );

        const buyRequestModalDone =
            document.getElementById(
                "buyRequestModalDone"
            );

        const buyRequestModalMessage =
            document.getElementById(
                "buyRequestModalMessage"
            );

        const buyRequestModalBackdrop =
            document.querySelector(
                ".buy-request-modal-backdrop"
            );


        function getBuyRequestVerificationToken()
        {
            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

            return token?.value || "";
        }


        function openBuyRequestModal(message)
        {
            if (!buyRequestModal) {
                return;
            }

            if (buyRequestModalMessage) {

                buyRequestModalMessage.textContent =
                    message ||
                    "Buy request has been sent to the seller.";
            }

            buyRequestModal.hidden = false;

            document.body.classList.add(
                "preview-modal-open"
            );
        }


        function closeBuyRequestModal()
        {
            if (!buyRequestModal) {
                return;
            }

            buyRequestModal.hidden = true;

            document.body.classList.remove(
                "preview-modal-open"
            );
        }


        async function sendBuyRequest()
        {
            if (!buyNowButton) {
                return;
            }

            const propertyGuid =
                buyNowButton.dataset.propertyGuid;

            if (!propertyGuid) {
                return;
            }

            buyNowButton.disabled = true;

            const body =
                new URLSearchParams();

            body.set(
                "propertyGuid",
                propertyGuid
            );

            try {

                const response =
                    await fetch(
                        "?handler=BuyNow",
                        {
                            method: "POST",

                            headers: {
                                "Accept":
                                    "application/json",

                                "Content-Type":
                                    "application/x-www-form-urlencoded; charset=UTF-8",

                                "RequestVerificationToken":
                                    getBuyRequestVerificationToken()
                            },

                            body:
                                body.toString()
                        }
                    );

                const result =
                    await response.json();

                if (
                    !response.ok ||
                    !result.success
                ) {
                    throw new Error(
                        result.message ||
                        "Unable to send the buy request."
                    );
                }

                openBuyRequestModal(
                    result.message
                );

            }
            catch (error) {

                console.error(
                    "Buy request error:",
                    error
                );

                openBuyRequestModal(
                    error.message ||
                    "Unable to send the buy request."
                );

            }
            finally {

                buyNowButton.disabled = false;

            }
        }


        buyNowButton?.addEventListener(
            "click",
            sendBuyRequest
        );


        buyRequestModalClose?.addEventListener(
            "click",
            closeBuyRequestModal
        );


        buyRequestModalDone?.addEventListener(
            "click",
            closeBuyRequestModal
        );


        buyRequestModalBackdrop?.addEventListener(
            "click",
            closeBuyRequestModal
        );
    </script>
    <script src="~/js/Buyer/favorite-toast.js"
        asp-append-version="true"></script>
}
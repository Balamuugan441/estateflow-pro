@{
    Layout = null;

    string IsActive(string page)
    {
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
        return currentPage == page ? "admin-nav-item active" : "admin-nav-item";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EstateFlow Pro Admin</title>

    <link rel="stylesheet"
          href="~/css/admin/admin-layout.css"
          asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="admin-shell">

        <!-- HEADER -->
        <header class="admin-header">
            <div class="main-header">
                <div class="header-container">

                    <!-- LEFT: BRAND -->
                    <div class="header-left">
                        <a asp-area="Seller"
                           asp-page="/MyProperties/Index"
                           class="header-brand"
                           aria-label="EstateFlow Pro">
                            <img src="~/images/branding/estateflow-pro-logo.png"
                                 alt="EstateFlow Pro"
                                 class="brand-logo-icon" />
                            <span class="brand-text">
                                EstateFlow <span>Pro</span>
                            </span>
                        </a>
                    </div>

                    <!-- RIGHT: PROFILE -->
                    <div class="header-right">
                        <div class="header-divider"></div>

                        <!-- USER PROFILE WRAPPER -->
                        <div class="user-profile-wrapper">
                            <div class="user-profile" id="userProfileToggle" role="button" tabindex="0" aria-expanded="false" aria-haspopup="true">
                                <div class="user-info">
                                    <span class="user-name">@User.Identity?.Name</span>
                                    <span class="user-role">ADMINISTRATOR</span>
                                </div>

                                <div class="user-avatar-wrapper">
                                    <img src="~/images/avatars/default-avatar.jpg"
                                         alt="Profile"
                                         class="user-avatar" />
                                </div>

                                <svg class="profile-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </div>

                            <!-- PROFILE DROPDOWN MENU -->
                            <div class="profile-dropdown-menu" id="profileDropdown" hidden>
                                <div class="dropdown-user-header">
                                    <span class="dropdown-user-name">@User.Identity?.Name</span>
                                    <span class="dropdown-user-role">Administrator</span>
                                </div>
                                <div class="dropdown-divider"></div>
                                <button type="button" class="dropdown-logout-btn" id="logoutBtn">
                                    <svg class="logout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                    <span>Log Out</span>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </header>

        <!-- ADMIN BODY -->
        <div class="admin-body">

            <!-- SIDEBAR -->
            <aside class="admin-sidebar">
                <nav class="admin-navigation" aria-label="Admin navigation">
                    <div class="admin-navigation-card">

                        <!-- Dashboard -->
                        <a asp-area="Admin" asp-page="/Dashboard/Index" class="@IsActive("/Dashboard/Index")">
                            <span class="admin-nav-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                                    <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                                    <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                                    <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                                </svg>
                            </span>
                            <span class="admin-nav-label">Dashboard</span>
                        </a>

                        <!-- Users -->
                        <a asp-area="Admin" asp-page="/Users/Index" class="@IsActive("/Users/Index")">
                            <span class="admin-nav-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </span>
                            <span class="admin-nav-label">Users</span>
                        </a>

                        <!-- Property Listings -->
                        <a asp-area="Admin" asp-page="/Properties/Index" class="@IsActive("/Properties/Index")">
                            <span class="admin-nav-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 21h18"></path>
                                    <path d="M5 21V7l7-4 7 4v14"></path>
                                    <path d="M9 18h6"></path>
                                    <path d="M10 10h4"></path>
                                    <path d="M10 14h4"></path>
                                </svg>
                            </span>
                            <span class="admin-nav-label">Property Listings</span>
                        </a>

                        <!-- Pending Approvals -->
                        <a asp-area="Admin" asp-page="/PendingApprovals/Index" class="@IsActive("/PendingApprovals/Index")">
                            <span class="admin-nav-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                                    <polyline points="9 14 11 16 15 11"></polyline>
                                </svg>
                            </span>
                            <span class="admin-nav-label">Pending Approvals</span>
                        </a>

                        <!-- Transactions -->
                        <a asp-area="Admin" asp-page="/Transactions/Index" class="@IsActive("/Transactions/Index")">
                            <span class="admin-nav-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                    <line x1="2" y1="10" x2="22" y2="10"></line>
                                </svg>
                            </span>
                            <span class="admin-nav-label">Transactions</span>
                        </a>

                        <!-- Activity Logs -->
                        <a asp-area="Admin" asp-page="/ActivityLogs/Index" class="@IsActive("/ActivityLogs/Index")">
                            <span class="admin-nav-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </span>
                            <span class="admin-nav-label">Activity Logs</span>
                        </a>
                        

                    </div>
                </nav>
            </aside>

            <!-- MAIN CONTENT -->
            <main class="admin-main">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/js/auth/profile-logout.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
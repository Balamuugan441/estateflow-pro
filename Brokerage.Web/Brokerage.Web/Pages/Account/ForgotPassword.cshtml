@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password - EstateFlow Pro</title>

    <link rel="stylesheet" href="~/css/login.css" />
</head>

<body class="login-page">

    <div class="login-wrapper">

        <div class="login-logo-header">
            <div class="login-logo"
                 role="img"
                 aria-label="EstateFlow Pro">
            </div>

            <h1 class="login-brand">
                EstateFlow <span>Pro</span>
            </h1>
        </div>

        <div class="login-card">

            <h2 class="login-title">
                Forgot Password
            </h2>

            <p class="login-description">
                Enter your email address and we will send you
                a link to reset your password.
            </p>
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="success-message">
                    @Model.SuccessMessage
                </div>
            }

            <form method="post" class="login-form">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="form-group">

                    <label asp-for="Input.Email"
                           class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Input.Email"
                           class="form-input"
                           placeholder="name@brokerage.com"
                           autocomplete="email" />

                    <span asp-validation-for="Input.Email"
                          class="validation-message">
                    </span>

                </div>

                <button type="submit"
                        class="login-button">
                    Send Reset Link
                </button>

            </form>

            <p class="login-footer-text">

                <a asp-page="./Login"
                   class="register-link">
                    Back to Login
                </a>

            </p>

        </div>

    </div>

</body>
</html>